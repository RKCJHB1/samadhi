# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local is ignored by git for security

# Feature Flags - Development Settings
VITE_ENABLE_3D_MODEL_VIEWER=true
VITE_ENABLE_AUTH_FEATURES=false
VITE_ENABLE_FUNDRAISING_FEATURES=true
VITE_DEV_MODE=true

# PayFast Configuration
# Get these from your PayFast account dashboard
VITE_PAYFAST_MERCHANT_ID=26034585
VITE_PAYFAST_MERCHANT_KEY=your_actual_merchant_key_here
