# ============================================
# Supabase Configuration for Admin Moderator System
# ============================================
#
# To set up:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings > API
# 3. Copy your Project URL and anon key below
# 4. Run the SQL schema (see supabase-schema.sql)
# 5. Set USE_SUPABASE_ADMIN = true in src/config/supabaseAdmin.ts
#
# ============================================

# Your Supabase project URL
VITE_SUPABASE_ADMIN_URL=https://your-project-id.supabase.co

# Your Supabase anonymous (public) key (safe for frontend)
VITE_SUPABASE_ADMIN_ANON_KEY=your-anon-key-here

# ============================================
# Legacy (if needed for other features)
# ============================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

